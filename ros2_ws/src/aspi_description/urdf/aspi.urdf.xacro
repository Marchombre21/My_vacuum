<?xml version="1.0"?>
    <robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="aspi">
        <xacro:property name="body_radius" value="0.125" />
        <xacro:property name="bodylen" value="0.134" />
        <xacro:property name="wheel_radius" value="0.0335" />
        <xacro:property name="wheel_width" value="0.027" />
        <xacro:property name="wheel_y" value="0.0996" />
        <xacro:property name="body_bottom" value="0.016" />

        <link name="base_link">
            <visual>
                <geometry>
                    <cylinder radius="${body_radius}" length="${bodylen}"/>
                </geometry>
                <origin xyz="0 0 ${body_bottom + bodylen / 2}" rpy="0 0 0"/>
            </visual>
        </link>

        <xacro:macro name="wheel" params="prefix reflect">
            <link name="${prefix}_wheel_link">
                <visual>
                    <origin rpy="${pi/2} 0 0"/>
                    <geometry>
                        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                    </geometry>
                </visual>
            </link>

            <joint name="${prefix}_wheel_joint" type="continuous">
                <parent link="base_link"/>
                <child link="${prefix}_wheel_link"/>
                <origin xyz="0 ${reflect * wheel_y} ${wheel_radius}" />
                <axis xyz="0 1 0"/>
            </joint>
        </xacro:macro>

        <xacro:wheel prefix="right" reflect="-1" />
        <xacro:wheel prefix="left" reflect="1" />

        <link name="caster_link">
            <visual>
                <geometry>
                    <sphere radius="0.01"/>
                </geometry>
            </visual>
        </link>

        <joint name="caster_joint" type="fixed">
            <parent link="base_link"/>
            <child link="caster_link"/>
            <origin xyz="0.095 0 0.01"/>
        </joint>

        <link name="imu_link">
            <visual>
                <geometry>
                    <box size="0.015 0.026 0.011"/>
                </geometry>
            </visual>
        </link>

        <joint name="imu_joint" type="fixed">
            <parent link="base_link"/>
            <child link="imu_link"/>
            <!-- z = 0.07 (étage) + 0.003 (épaisseur) + 0.0055 (moitié de l'épaisseur de l'imu) -->
            <origin xyz="0 0 0.0785"/>
        </joint>

        <link name="laser">
            <visual>
                <geometry>
                    <cylinder radius="0.0275" length="0.042"/>
                </geometry>
                <origin xyz="0 0 -0.0115"/>
            </visual>
        </link>

        <joint name="laser_joint" type="fixed">
            <parent link="base_link"/>
            <child link="laser"/>
            <origin xyz="0 0 ${body_bottom + bodylen + 0.023 + 0.0095}"/>
        </joint>
    </robot>
